# Copie para /home/deploy/.healthbot.env (fora do git) e preencha.
# Token vem do @BotFather; chat_id você descobre com getUpdates depois de
# mandar uma mensagem pro bot - ver DEPLOY.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Mesmo valor que HEALTHBOT_API_KEY no .env do docker-compose (raiz do
# projeto) - precisa bater com o que o backend espera, senão /live e /resumo
# voltam vazios. Gere com: openssl rand -hex 32
HEALTHBOT_API_KEY=
