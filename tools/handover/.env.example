# Copie para .env (cp .env.example .env) e preencha. Nunca envie este arquivo a ninguém.

# Domínio que aponta para este servidor (ex.: painel.seudominio.com.br)
DOMAIN=

# Primeiro administrador do painel (/admin). A senha precisa de 8+ caracteres,
# uma maiúscula e um caractere especial. Depois do primeiro acesso você pode
# apagar estas duas linhas.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# IPs de saída para o SuperLive: UM PROXY FIXO BRASILEIRO por IP (ISP/residencial estático),
# separados por vírgula, NA ORDEM EM QUE FOREM CONTRATADOS (nunca reordene nem remova um que já
# tem criadoras). Formato: socks5h://usuario:senha@host:porta
# Se a senha tiver caracteres especiais (@ : / # %), troque-os pelo código %XX.
SUPERLIVE_PROXY_URLS=

# Criadoras por IP (cadastro e robôs). Não aumente sem medir.
SM_SESSIONS_PER_EGRESS=7

# Preenchido pelo install.sh
HEALTHBOT_API_KEY=
